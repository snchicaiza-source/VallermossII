RewriteEngine On

# Redireccionador limpio de WhatsApp: /ws/CODIGO -> ws.php?c=CODIGO
RewriteRule ^ws/([a-zA-Z0-9_-]+)/?$ ws.php?c=$1 [L,QSA]

# Proteger directorios sensibles (solo GET)
RewriteCond %{REQUEST_METHOD} =GET
RewriteRule ^(config|models|services)/ - [F,L]

# Headers de seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
